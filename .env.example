# Copy this file to .env and replace the placeholder secrets before starting.

# PostgreSQL
POSTGRES_DB=social_media
POSTGRES_USER=social_media
POSTGRES_PASSWORD=change-me-before-use

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
BACKEND_PORT=8000

# Next.js and published host ports
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
FRONTEND_PORT=3000
